# Copie para .env e preencha:  cp .env.example .env
# O arquivo .env NUNCA deve ser versionado (já está no .gitignore).
# Comentários ficam sempre em linhas próprias (alguns leitores de .env não aceitam comentário no fim da linha).

# ---------------- Ambiente ----------------
# "production" ativa as validações de segurança (CORS sem "*", JWT_SECRET forte, senha do gestor)
APP_ENV=development

# ---------------- IA (qualquer API compatível com OpenAI) ----------------
# "openai_compat" = LLM real  |  "mock" = IA simulada por palavras-chave (só para testes/demonstração offline)
LLM_PROVIDER=openai_compat
# Sua chave de API (nunca coloque no código)
LLM_API_KEY=

# Opção 1 — Groq (plano gratuito): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# Opção 2 — Google Gemini (plano gratuito): https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_REASONING_EFFORT=low

# Opção 3: modelo local com llama.cpp (sem chave e sem custo; foi o usado nas avaliações deste projeto)
#   python -m llama_cpp.server --model qwen2.5-1.5b-instruct-q4_k_m.gguf --port 8080 --n_ctx 4096 --chat_format chatml
# LLM_API_KEY=local
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=qwen2.5-1.5b-instruct
# LLM_REASONING_EFFORT=
# LLM_TIMEOUT_S=300
# LLM_MAX_TOKENS=700

# Opção 4 — OpenAI (deixe LLM_REASONING_EFFORT vazio para modelos sem raciocínio)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_REASONING_EFFORT=

# json_object | json_schema | none
LLM_JSON_MODE=json_object
LLM_TIMEOUT_S=25
# Use -1 para não enviar temperature (modelos que não aceitam o parâmetro)
LLM_TEMPERATURE=0.1
# 1 chamada + 1 nova tentativa quando a saída não passa na validação do Pydantic
LLM_MAX_TENTATIVAS=2
# Limite de tokens gerados (0 = não enviar; em modelos de raciocínio, deixe 0)
LLM_MAX_TOKENS=0

# ---------------- Assistente (RAG) e visão computacional ----------------
# hibrido (BM25 + embeddings) | bm25 (mais leve, sem baixar modelo) | denso
BUSCA_MODO=hibrido
ASSISTENTE_K=4
# Pasta para o modelo de embeddings baixado no primeiro uso. Sem a variável, vale o cache
# padrão do fastembed; no Docker o caminho é definido pelo docker-compose.yml.
# MODELOS_CACHE_DIR=

# ---------------- Segurança ----------------
# Lista explícita de origens permitidas; "*" é recusado em produção
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Gere um valor com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
GESTOR_USUARIO=gestor
# Obrigatória para acessar a área do gestor
GESTOR_SENHA=
TOKEN_TTL_MIN=120
RATE_LIMIT_POR_MIN=12
# Fuso dos horários gravados e exibidos (o servidor pode estar em UTC)
FUSO_HORARIO=America/Sao_Paulo

# ---------------- Dados ----------------
DATABASE_PATH=data/zela.db
# Registros FICTÍCIOS para o painel não começar vazio (sinalizados na interface)
SEED_DEMO_DATA=true
# BrasilAPI/ViaCEP, Nominatim (OpenStreetMap) e Open-Meteo
USAR_DADOS_EXTERNOS=true

# ---------------- Robô RPA (robo_rpa/) ----------------
ZELA_API_URL=http://localhost:8000
ZELA_GESTOR_USUARIO=gestor
ZELA_GESTOR_SENHA=
# Sem SMTP o boletim é salvo como arquivo .eml em robo_rpa/saida/
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DESTINO=

# ---------------- Assistente de voz (assistente_voz/) ----------------
# small (padrão) ou tiny (máquinas mais fracas)
STT_MODELO=small
# faber ou cadu (vozes sintéticas do Piper)
TTS_VOZ=faber

# ---------------- Front-end ----------------
# No Docker Compose é sobrescrito para http://api:8000
API_URL=http://localhost:8000
