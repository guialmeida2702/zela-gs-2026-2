# Copie para robo_rpa/.env e preencha. O .env fica fora do repositório (.gitignore).
# Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# API do Zela e login de gestor (a mesma senha de GESTOR_SENHA da API)
ZELA_API_URL=http://localhost:8000
ZELA_GESTOR_USUARIO=gestor
ZELA_GESTOR_SENHA=

# E-mail do boletim (opcional). Sem SMTP, o boletim é salvo como arquivo .eml em saida/
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DESTINO=
