digraph ouviai {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.4, pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#0F5C63", fillcolor="#E8F2F2", margin="0.14,0.08"];
  edge  [color="#4A5654", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  som [label="Som do ambiente\n(campainha, batida\nou ambiente)", shape=ellipse, fillcolor="#FFFFFF"];
  mic [label="Microfone\ndo celular\n16 kHz, mono"];
  mfe [label="MFE\nespectrograma\nem escala Mel"];
  cnn [label="CNN\n(Edge Impulse)"];
  tela [label="Classe e confiança\nna tela do celular\n(navegador)", shape=ellipse, fillcolor="#FFFFFF"];
  som -> mic -> mfe -> cnn -> tela;
}
